  "kind": "instrument_calibration",
  "dataset": "shapes3d",
  "amendment": "A8 §c (headroom) + A8 §e (capacity axis)",
  "role": "diagnostic only — no decision rule, no confirmatory family",
  "blind_guard": "scored on the 'shape' anchor only (§5 gate factor)",
  "run": "first execution, pre-A9 (probe budget in epochs, not gradient steps)",
  "status": "VOID — does not pin a probe configuration",
  "anchor": {
    "name": "shape",
    "n_values": 4,
    "chance": 0.25,
    "metric": "normalized accuracy (acc - chance) / (1 - chance)",
    "zero_accuracy_floor": -0.3333
  },
  "rungs": [
    "linear",
    "mlp_small",
    "mlp_large",
    "mlp_deep"
  ],
  "saturation_level": 0.9,
  "probe_budget_pre_a9": {
    "epochs": 100,
    "batch": 4096,
    "steps_by_probe_train_size": {
      "2000": 100,
      "5000": 200,
      "10000": 300,
      "40000": 1000
    }
  },
  "invalidations": [
    {
      "id": "A9",
      "scope": "cross-n comparison, both regimes",
      "finding": "the epoch-based budget gave 100 steps at n=2000 and 1000 at n=40000, so probe-train size and optimizer budget moved together; a floor that falls at small n cannot be separated from a probe that did not converge",
      "status": "amended — ladder.DEFAULT_STEPS = 1000 pins the step budget; re-run required"
    },
    {
      "id": "extrapolation-construct-validity",
      "scope": "all 8 extrapolation rows",
      "finding": "make_value_holdout_splits withholds whole values of the anchor factor, which is well-posed for a continuous factor but not for a class label: probe-test contains only unseen classes, so every cell returns the zero-accuracy floor regardless of encoder, probe capacity or probe-train size",
      "status": "unamended — the regime measures nothing on a categorical anchor"
    },
    {
      "id": "recommended-config-selection",
      "scope": "recommended_config / verdict emitted by the run",
      "finding": "the selector keeps rows with saturated_at_top == False and sorts extrapolation first, largest n first; the extrapolation rows are unsaturated precisely because they fail, so the output is fixed by the code and independent of the data",
      "status": "unamended — recommendation withheld, see instrument_calibration.py:155-166"
    }
  ],
